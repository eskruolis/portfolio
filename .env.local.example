# Upstash Redis — view counters
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub — optional, raises API rate limit from 60 to 5000 req/hr
# Create a fine-grained token with public repo read access at https://github.com/settings/tokens
GITHUB_TOKEN=

# Site URL — used for OG images and absolute URLs
# Set to your production domain (e.g. https://eskruolis.dev)
NEXT_PUBLIC_SITE_URL=

# LAN dev access — comma-separated IPs/hosts to allow in Next.js dev server
# e.g. NEXT_DEV_ALLOWED_ORIGINS=192.168.1.210
NEXT_DEV_ALLOWED_ORIGINS=
